{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "soulOSX",
  "identifier": "com.projectsoul.soulosx",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "soulOSX",
        "label": "main",
        "width": 1480,
        "height": 940,
        "minWidth": 1024,
        "minHeight": 680,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* https://alm-solutions.de; img-src 'self' data: https:; font-src 'self' data:"
    }
  }
}
